import java.util.List;

/**
 * This class contains the data of a Route such as list of locations, number of stops,
 * and total distance.
 * 
 * @author angel + samar
 */
public class Route {
	private List<Location> locationList;
	private double totalDistance = 0;
	
	/**
	 * Creates a Route with a list of locations, number of stops, and total distance.
	 * 
	 * @param locationList List of locations on campus.
	 * @param numStops Number of stops from starting position to destination not 
	 * including starting position.
	 * @param totalDistance The distance from starting position to destination in feet.
	 */
	public Route(List<Location> locationList, double totalDistance) {
		this.locationList = locationList;
		this.totalDistance = totalDistance;
	}

	/**
	 * Returns the list of locations on the route.
	 * 
	 * @return The locationList.
	 */
	public List<Location> getLocationList() {
		return locationList;
	}

	/**
	 * Returns the number of stops between the starting and ending points (including)
	 *  on
	 * the route.
	 * 
	 * @return The numStops.
	 */
	public int getNumStops() {
		return locationList.size() - 1;
	}

	/**
	 * Returns the total distance between the starting and ending points on
	 * the route.
	 * 
	 * @return The totalDistance.
	 */
	public double getTotalDistance() {
		return totalDistance;
	}
	
	/**
	 * Returns the starting position on the route.
	 * 
	 * @return The first entry in locationList.
	 */
	public Location getStart() {
		return locationList.get(0);
	}
	
	/**
	 * Returns the destination on the route.
	 * 
	 * @return The last entry in locationList.
	 */
	public Location getDestination() {
		return locationList.get(locationList.size() - 1);
	}
}
